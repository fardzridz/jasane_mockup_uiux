            <mxPoint x="150" y="200" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- 2. User taps Bayar -->
        <mxCell id="msg02" value="2: Tap 'Bayar'" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="actor-user" target="obj-supabase">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="220" as="sourcePoint" />
            <mxPoint x="350" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 3. Call Edge Function -->
        <mxCell id="msg03" value="3: supabase.functions.invoke('create-booking', {data})" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-supabase" target="obj-edge-fn">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="250" as="sourcePoint" />
            <mxPoint x="550" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 4. Verify JWT -->
        <mxCell id="msg04" value="4: Verify JWT token" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="280" as="sourcePoint" />
            <mxPoint x="550" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 5. Query mitra availability -->
        <mxCell id="msg05" value="5: SELECT * FROM mitra_profiles WHERE id=?" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-edge-fn" target="obj-db">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="320" as="sourcePoint" />
            <mxPoint x="750" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="msg06" value="6: {is_verified: true, is_available: true}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;" edge="1" parent="1" source="obj-db" target="obj-edge-fn">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="350" as="sourcePoint" />
            <mxPoint x="550" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 7. Check schedule -->
        <mxCell id="msg07" value="7: SELECT * FROM mitra_schedules WHERE mitra_id=? AND day_of_week=?" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-edge-fn" target="obj-db">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="380" as="sourcePoint" />
