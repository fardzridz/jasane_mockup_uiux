        <!-- 29. Insert notification -->
        <mxCell id="msg29" value="29: INSERT INTO notifications (user_id, type='booking_new', ...)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-edge-fn" target="obj-db">
          <mxGeometry relative="1" as="geometry">
