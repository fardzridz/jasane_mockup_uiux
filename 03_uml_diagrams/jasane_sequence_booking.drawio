            <mxPoint x="550" y="520" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 12. Insert booking_items -->
        <mxCell id="msg12" value="12: INSERT INTO booking_items (service_id, price, qty, ...)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-edge-fn" target="obj-db">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="550" as="sourcePoint" />
            <mxPoint x="750" y="550" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 13. Create chat room -->
        <mxCell id="msg13" value="13: INSERT INTO chat_rooms (booking_id, user_id, mitra_id)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-edge-fn" target="obj-db">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="580" as="sourcePoint" />
            <mxPoint x="750" y="580" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 14. Create Xendit invoice -->
        <mxCell id="msg14" value="14: POST /v2/invoices {amount, external_id, ...}" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-edge-fn" target="obj-xendit">
          <mxGeometry relative="1" as="geometry">
