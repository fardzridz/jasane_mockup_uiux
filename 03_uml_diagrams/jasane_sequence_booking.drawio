            <mxPoint x="750" y="930" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 25. Get mitra FCM token -->
        <mxCell id="msg25" value="25: SELECT fcm_token FROM users WHERE id=(SELECT user_id FROM mitra_profiles WHERE id=?)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-edge-fn" target="obj-db">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="970" as="sourcePoint" />
            <mxPoint x="750" y="970" as="targetPoint" />
