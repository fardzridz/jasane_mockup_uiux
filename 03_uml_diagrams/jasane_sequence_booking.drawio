        <mxCell id="msg18" value="18: Return response" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;" edge="1" parent="1" source="obj-supabase" target="actor-user">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="740" as="sourcePoint" />
            <mxPoint x="150" y="740" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 19. Open WebView -->
        <mxCell id="msg19" value="19: Open WebView(invoice_url)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="770" as="sourcePoint" />
            <mxPoint x="950" y="770" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 20. User pays -->
        <mxCell id="msg20" value="20: User bayar via QRIS/Transfer/E-wallet" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="800" as="sourcePoint" />
            <mxPoint x="950" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 21. Xendit webhook -->
        <mxCell id="msg21" value="21: POST /functions/v1/xendit-webhook {status: 'PAID', ...}" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;fontStyle=1;" edge="1" parent="1" source="obj-xendit" target="obj-edge-fn">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="950" y="840" as="sourcePoint" />
            <mxPoint x="550" y="840" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 22. Update payment status -->
        <mxCell id="msg22" value="22: UPDATE payments SET status='paid', paid_at=NOW() WHERE xendit_invoice_id=?" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-edge-fn" target="obj-db">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="870" as="sourcePoint" />
            <mxPoint x="750" y="870" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 23. Update booking status -->
        <mxCell id="msg23" value="23: UPDATE bookings SET status='paid' WHERE id=?" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-edge-fn" target="obj-db">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="900" as="sourcePoint" />
            <mxPoint x="750" y="900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 24. Create earnings record -->
        <mxCell id="msg24" value="24: INSERT INTO mitra_earnings (mitra_id, net_amount, status='pending', ...)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-edge-fn" target="obj-db">
          <mxGeometry relative="1" as="geometry">
