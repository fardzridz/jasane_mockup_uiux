        <mxCell id="msg11" value="11: {booking_id, booking_code}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;" edge="1" parent="1" source="obj-db" target="obj-edge-fn">
          <mxGeometry relative="1" as="geometry">
