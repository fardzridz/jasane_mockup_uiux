        <mxCell id="msg10" value="10: INSERT INTO bookings (status='terjadwal', ...)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-edge-fn" target="obj-db">
          <mxGeometry relative="1" as="geometry">
