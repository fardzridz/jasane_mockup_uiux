        </mxCell>
        
        <mxCell id="msg26" value="26: {fcm_token}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;" edge="1" parent="1" source="obj-db" target="obj-edge-fn">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="1000" as="sourcePoint" />
            <mxPoint x="550" y="1000" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 27. Send push notification -->
        <mxCell id="msg27" value="27: POST /fcm/send {token, title: 'Pesanan masuk!', body: ...}" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-edge-fn" target="obj-fcm">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1030" as="sourcePoint" />
            <mxPoint x="1150" y="1030" as="targetPoint" />
