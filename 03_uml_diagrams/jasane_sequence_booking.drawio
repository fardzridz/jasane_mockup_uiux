        <!-- 28. FCM delivers to mitra -->
        <mxCell id="msg28" value="28: Push notification delivered" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-fcm" target="actor-mitra">
          <mxGeometry relative="1" as="geometry">
