            <mxPoint x="950" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="msg15" value="15: {invoice_id, invoice_url, expired_at}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;" edge="1" parent="1" source="obj-xendit" target="obj-edge-fn">
