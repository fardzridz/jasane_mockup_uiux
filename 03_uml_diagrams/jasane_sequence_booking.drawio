            <mxPoint x="950" y="650" as="sourcePoint" />
            <mxPoint x="550" y="650" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 16. Save payment record -->
        <mxCell id="msg16" value="16: INSERT INTO payments (xendit_invoice_id, invoice_url, ...)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-edge-fn" target="obj-db">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="680" as="sourcePoint" />
            <mxPoint x="750" y="680" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 17. Return invoice URL -->
        <mxCell id="msg17" value="17: {booking_id, invoice_url, total_amount}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;" edge="1" parent="1" source="obj-edge-fn" target="obj-supabase">
          <mxGeometry relative="1" as="geometry">
