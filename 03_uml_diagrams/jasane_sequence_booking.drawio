        <!-- Messages -->
        <!-- 1. User selects service & slot -->
        <mxCell id="msg01" value="1: Pilih layanan + slot + isi detail" style="html=1;verticalAlign=bottom;endArrow=block;entryX=0;entryY=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry x="0.1" y="10" relative="1" as="geometry">
