        <!-- Phase 1: Webhook Received -->
        <mxCell id="phase1" value="PHASE 1: Payment Success Webhook" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;width=280;height=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="1000" height="280" as="geometry" />
        </mxCell>
        
        <!-- 1. Xendit sends webhook -->
        <mxCell id="msg01" value="1: POST /xendit-webhook&#xa;{status: 'PAID', id: 'inv_xxx', ...}" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;fontStyle=1;" edge="1" parent="1" source="obj-xendit" target="obj-webhook">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="200" as="sourcePoint" />
            <mxPoint x="350" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 2. Verify webhook token -->
        <mxCell id="msg02" value="2: Verify x-callback-token" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="230" as="sourcePoint" />
            <mxPoint x="350" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 3. Update payment status -->
        <mxCell id="msg03" value="3: UPDATE payments SET status='paid', paid_at=NOW(), xendit_raw=? WHERE xendit_invoice_id=?" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-webhook" target="obj-db">
