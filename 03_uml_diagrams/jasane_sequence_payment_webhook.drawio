            <mxPoint x="550" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 6. Create earnings with escrow -->
        <mxCell id="msg06" value="6: INSERT INTO mitra_earnings&#xa;(status='pending', escrow_release_at=NOW() + INTERVAL '24 hours')" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;fontStyle=1;" edge="1" parent="1" source="obj-webhook" target="obj-db">
