        <!-- Note about escrow -->
        <mxCell id="note01" value="⏳ Dana ditahan 24 jam untuk&#xa;Service Protection Window.&#xa;Pelanggan bisa ajukan dispute&#xa;jika layanan tidak sesuai." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;" vertex="1" parent="1">
