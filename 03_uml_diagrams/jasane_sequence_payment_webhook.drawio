            <mxPoint x="350" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- 5. Update booking status -->
        <mxCell id="msg05" value="5: UPDATE bookings SET status='paid' WHERE id=?" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-webhook" target="obj-db">
