        <!-- 7. Realtime broadcast -->
        <mxCell id="msg07" value="7: Broadcast booking status change" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1" source="obj-db" target="obj-realtime">
          <mxGeometry relative="1" as="geometry">
